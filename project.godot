; Fichier de configuration du projet Godot. Ne pas modifier à la main sauf besoin.

config_version=5

[application]

config/name="Prototype Tower Defense"
run/main_scene="res://scenes/hub.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Profile="*res://scripts/profile.gd"
Run="*res://scripts/run_state.gd"
Touch="*res://scripts/touch.gd"
Fonts="*res://scripts/fonts.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=736
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
